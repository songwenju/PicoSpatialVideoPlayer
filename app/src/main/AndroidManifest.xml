<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name="com.picoxr.destinationvideo.LocalDemoApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DestinationVideo">

        <activity
            android:name="com.picoxr.destinationvideo.MainActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|navigation|density|smallestScreenSize"
            android:exported="true"
            android:theme="@style/Theme.DestinationVideo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="pico.spatial.windowcontainer.id"
                android:value="home" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizemode"
                android:value="1" />
            <!-- WindowGroup's style -->
            <meta-data
                android:name="pico.spatial.windowcontainer.style"
                android:value="1" />
            <!-- Default size of the WindowGroup,1600*900 对应设计稿 1280 * 720 dp-->
            <meta-data
                android:name="pxr.spatial.isspatial"
                android:value="1" />

            <meta-data
                android:name="pico.spatial.windowcontainer.materialbackground"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizetype"
                android:value="2" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizerestriction"
                android:value="1" />

        </activity>

        <activity
            android:name="com.picoxr.destinationvideo.DestinationPlayerActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|navigation|density|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.DestinationVideo">

            <meta-data
                android:name="pico.spatial.windowcontainer.id"
                android:value="destination_player" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizemode"
                android:value="1" />
            <meta-data
                android:name="pico.spatial.windowcontainer.style"
                android:value="1" />
            <meta-data
                android:name="pxr.spatial.isspatial"
                android:value="1" />
            <meta-data
                android:name="pico.spatial.windowcontainer.materialbackground"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizetype"
                android:value="2" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizerestriction"
                android:value="1" />

        </activity>

        <meta-data
            android:name="pico.spatial.use_experimental_api"
            android:value="1" />
    </application>

</manifest>
